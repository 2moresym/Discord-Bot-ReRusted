# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Primary AI provider: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional future fallback provider
HF_TOKEN=

# OpenRouter model. "openrouter/free" lets OpenRouter select an eligible free model.
OPENROUTER_MODEL=openrouter/free

# Comma-separated Discord channel names where @ReRusted may trigger an AI reply.
# Names are matched case-insensitively. Leave empty to disable automatic mention replies.
AI_CHANNEL_NAMES=ai-chat

# Editable personality/instructions sent as the AI system prompt.
# Keep this on one line in .env unless you quote/escape newlines yourself.
AI_SYSTEM_PROMPT=You are Vaxxer, a friendly Discord bot. Be helpful, conversational, concise, and playful without being obnoxious. Do not claim to be human or have real-world experiences.

# Optional: set this for less noisy logs (trace, debug, info, warn, error)
RUST_LOG=info
