# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Primary AI provider: https://console.groq.com/keys
GROQ_API_KEY=

# Optional future fallback/provider integration
HF_TOKEN=

# Groq model. See https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# Optional: set this for less noisy logs (trace, debug, info, warn, error)
RUST_LOG=info
