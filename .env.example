# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Cerebras Cloud API key
CEREBRAS_API_KEY=

# Cerebras public model
CEREBRAS_MODEL=gpt-oss-120b

# Reasoning effort for gpt-oss-120b: low, medium, or high
CEREBRAS_REASONING_EFFORT=medium

# Maximum completion tokens, including reasoning tokens
CEREBRAS_MAX_COMPLETION_TOKENS=512

# Comma-separated Discord channel IDs where @ReRusted may trigger an AI reply.
# Multiple IDs can belong to different servers.
# Leave empty to disable automatic mention replies.
AI_CHANNEL_IDS=123456789012345678,987654321098765432

# Persistent local VxMem store. Keep it outside the Git repository.
VXM_PATH=/home/vexx/.local/share/rerusted/memory.vxm

# Recent messages included automatically for the active conversation scope.
VXM_HISTORY_LIMIT=50

# Maximum messages retained on disk per conversation scope.
# Older messages remain searchable by VxMem until this cap is reached.
VXM_MAX_MESSAGES=10000

# Path to the editable AI personality/context file.
AI_CONTEXT_FILE=context.md

# Optional logging level: trace, debug, info, warn, error
RUST_LOG=info
