# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Hugging Face token with Inference Providers permission
HF_TOKEN=

# Hugging Face chat model. :fastest selects the fastest available provider.
HF_MODEL=openai/gpt-oss-120b:fastest

# Comma-separated Discord channel IDs where @ReRusted may trigger an AI reply.
# Multiple IDs can belong to different servers.
# Leave empty to disable automatic mention replies.
AI_CHANNEL_IDS=123456789012345678,987654321098765432

# Path to the local VxMem database file. Do not commit this file.
VXM_PATH=memory.vxm

# Number of recent messages retained per conversation scope.
VXM_HISTORY_LIMIT=8

# Path to the editable AI personality/context file.
AI_CONTEXT_FILE=context.md

# Optional: set this for less noisy logs (trace, debug, info, warn, error)
RUST_LOG=info
